import React, { useMemo, useState } from "react";

const DEFAULT_PR_URL = "https://github.com/owner/repo/pull/123";

function prettyJson(value) {
  try {
    return JSON.stringify(value, null, 2);
  } catch {
    return String(value);
  }
}

export default function test() {
  const [prUrl, setPrUrl] = useState(DEFAULT_PR_URL);
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState(null);
  const [error, setError] = useState("");

  const snapshotUrl = useMemo(() => {
    const params = new URLSearchParams({ prUrl });
    return `/api/reviews/snapshot?${params.toString()}`;
  }, [prUrl]);

  async function enqueueReview() {
    setLoading(true);
    setError("");
    setResult(null);
    try {
      const res = await fetch("/api/reviews", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ prUrl }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Failed to enqueue PR");
      setResult({ endpoint: "/api/reviews", data });
    } catch (e) {
      setError(e instanceof Error ? e.message : "Unknown error");
    } finally {
      setLoading(false);
    }
  }

  async function fetchSnapshot() {
    setLoading(true);
    setError("");
    setResult(null);
    try {
      const res = await fetch(snapshotUrl);
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Failed to fetch snapshot");
      setResult({ endpoint: snapshotUrl, data });
    } catch (e) {
      setError(e instanceof Error ? e.message : "Unknown error");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="page">
      <section className="card">
        <h1>AI PR Review API Tester</h1>
        <p>Test enqueue and snapshot endpoints from a simple React UI.</p>

        <label htmlFor="prUrl">GitHub PR URL</label>
        <input
          id="prUrl"
          value={prUrl}
          onChange={(e) => setPrUrl(e.target.value)}
          placeholder="https://github.com/owner/repo/pull/123"
        />

        <div className="actions">
          <button type="button" disabled={loading} onClick={enqueueReview}>
            {loading ? "Please wait..." : "1) Enqueue PR Fetch"}
          </button>
          <button type="button" disabled={loading} onClick={fetchSnapshot}>
            {loading ? "Please wait..." : "2) Get Snapshot"}
          </button>
        </div>

        <p className="hint">
          Snapshot API URL: <code>{snapshotUrl}</code>
        </p>

        {error ? <pre className="error">{error}</pre> : null}
        {result ? <pre className="result">{prettyJson(result)}</pre> : null}
      </section>
    </main>
  );
}
